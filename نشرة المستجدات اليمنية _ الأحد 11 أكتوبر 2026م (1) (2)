Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-979f7cc0-135d-4b13-bd1c-989c59c4d19b@mhtml.blink

@charset "utf-8";

:root { --navy: #071a29; --blue: #0c2438; --gold: #e5bd42; --red: #a21d2b; --paper: #f4f5f7; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--navy); color: rgb(24, 33, 42); font-family: Arial, Tahoma, sans-serif; line-height: 1.9; }

.wrap { max-width: 980px; margin: auto; padding: 12px; }

.hero, .card { background: var(--paper); border: 3px solid var(--gold); border-radius: 16px; padding: 18px; margin: 14px 0px; }

.hero { text-align: center; background: var(--blue); color: white; }

.hero h1 { color: rgb(243, 203, 84); margin: 4px; font-size: clamp(1.5rem, 5vw, 2.25rem); }

h2 { color: var(--red); margin-top: 0px; }

h3 { margin-bottom: 5px; }

.btn { display: inline-block; background: rgb(21, 61, 89); text-decoration: none; padding: 9px 13px; border-radius: 9px; font-weight: bold; margin: 5px 0px; color: white !important; }

a { color: rgb(7, 92, 155); overflow-wrap: anywhere; }

.tag { display: inline-block; background: rgb(255, 240, 191); color: rgb(118, 83, 0); padding: 2px 10px; border-radius: 20px; font-weight: bold; }

.status { background: rgb(255, 244, 212); border-right: 5px solid var(--gold); padding: 10px; border-radius: 8px; }

.muted { color: rgb(228, 233, 239); }

.poster { display: block; width: 100%; height: auto; border-radius: 10px; border: 1px solid rgb(198, 203, 208); }

.headline { padding: 14px 0px; border-bottom: 1px solid rgb(213, 217, 222); }

.headline:last-child { border-bottom: 0px; }

li { margin: 8px 0px; }

footer { text-align: center; color: white; background: var(--blue); border: 2px solid var(--gold); padding: 16px; border-radius: 12px; margin: 18px 0px; }

@media (max-width: 600px) {
  .wrap { padding: 7px; }
  .hero, .card { padding: 12px; }
  .btn { display: block; text-align: center; }
}
